# api
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=text
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30
WS_MAX_CONNECTIONS=200

# storage, service names from infra/docker-compose.yml
DATABASE_URL=postgres://flightpath:flightpath@postgres:5432/flightpath?sslmode=disable
REDIS_URL=redis://redis:6379/0

# opensky, leave the client fields empty to poll anonymously
POLLER_ENABLED=true
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_DAILY_CREDITS=4000
OPENSKY_CREDIT_RESERVE=400
OPENSKY_ACTIVE_INTERVAL=15s
OPENSKY_IDLE_INTERVAL=15m

# aviationstack
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
AVIATIONSTACK_MONTHLY_CAP=95

# adsbdb
ADSBDB_BASE_URL=https://api.adsbdb.com/v0

# retention
TRAIL_RETENTION=6h
