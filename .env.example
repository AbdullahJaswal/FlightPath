# api
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=text
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30
WS_MAX_CONNECTIONS=200

# storage, service names from infra/docker-compose.yml
DATABASE_URL=postgres://flightpath:flightpath@postgres:5432/flightpath?sslmode=disable
REDIS_URL=redis://redis:6379/0

# adsb feed, a readsb style aggregator queried one 250 nm circle at a time
POLLER_ENABLED=true
ADSB_BASE_URL=https://opendata.adsb.fi/api/v3
ADSB_USER_AGENT=Flightpath/1.0 (+https://abdullahjaswal.dev/)
ADSB_RADIUS_NM=250
ADSB_MIN_INTERVAL=1200ms
ADSB_ACTIVE_INTERVAL=10s
ADSB_IDLE_INTERVAL=1600ms
ADSB_MAX_CELLS=12
ADSB_DAILY_REQUESTS=60000
ADSB_WORLD_SWEEP=true

# aviationstack
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
AVIATIONSTACK_MONTHLY_CAP=95

# adsbdb
ADSBDB_BASE_URL=https://api.adsbdb.com/v0

# planespotters, the user agent must name a contact URL or email
PLANESPOTTERS_ENABLED=true
PLANESPOTTERS_BASE_URL=https://api.planespotters.net/pub
PLANESPOTTERS_USER_AGENT=Flightpath/1.0 (+https://abdullahjaswal.dev/)

# freshness
TRAIL_RETENTION=6h
SNAPSHOT_STALE_AFTER=3m
